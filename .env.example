GEMINI_API_KEY=
JEV_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash-lite
# JEV_MODEL=jev-latest
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# MAKE_PHOTOS=0 # never ask the image model for a photograph; pictures come from the library or stay painted frames
# BAKER_MODEL=gemini-3.8-flash   # writes custom components; the only model here that writes code
# SPECULATE=1   # start all section writers before the plan exists (8 Gemini requests per run)
# GEMINI_RPM=15 # make `npm run eval` pace itself under a requests-per-minute quota
# Google sign-in (Firebase), an access list and daily counts in Firestore; leave out and nobody signs in (src/server/auth.ts).
# Locally the database is reached as whoever `gcloud auth application-default login` says.
# FIREBASE_PROJECT=my-project
# FIREBASE_API_KEY=AIza...   # the Firebase web app's key: public, it goes to the browser
# DAILY_RUNS=50             # for a maker whose grant does not say
