{
  "name": "jev2ui",
  "version": "1.0.0",
  "description": "Describe a screen, get a mock: Jev decides, Gemini writes, a DESIGN.md paints",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --external:@google/design.md --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\" --outfile=dist-server/main.js --log-level=warning && cp src/server/photos/library.json dist-server/library.json && rm -rf dist-server/grammar && cp -R grammar dist-server/grammar",
    "start": "node dist-server/main.js",
    "typecheck": "tsc",
    "eval": "tsx src/eval.ts",
    "probe:jtbd": "tsx src/probe/jtbd.ts",
    "probe:design": "tsx src/probe/design.ts",
    "photos:build": "tsx src/server/photos/build.ts",
    "probe:custom": "tsx src/probe/custom.ts",
    "probe:change": "tsx src/probe/change.ts",
    "probe:coherence": "tsx src/probe/coherence.ts",
    "probe:ia": "tsx src/probe/ia.ts",
    "probe:ia:samples:audit": "tsx src/probe/ia-samples-audit.ts",
    "probe:ia:samples": "tsx src/probe/ia-samples.ts",
    "probe:ia:whole": "tsx src/probe/ia.ts --whole",
    "observe:journeys": "tsx src/probe/journey-observer.ts",
    "probe:identity": "tsx src/probe/identity.ts",
    "grammar:export": "tsx src/server/grammar/export.ts",
    "probe:grammar": "tsx src/probe/grammar.ts",
    "probe:draw": "tsx src/probe/grammar-draw.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dglazkov/jev2ui.git"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "bugs": {
    "url": "https://github.com/dglazkov/jev2ui/issues"
  },
  "homepage": "https://github.com/dglazkov/jev2ui#readme",
  "dependencies": {
    "@a2ui/lit": "^0.11.0",
    "@a2ui/markdown-it": "^0.1.2",
    "@a2ui/web_core": "^0.11.0",
    "@google/design.md": "^0.4.0",
    "@google/genai": "^2.23.0",
    "@lit/context": "^1.1.6",
    "@typesafe-ai/sdk": "^0.6.0",
    "dotenv": "^18.0.1",
    "firebase": "^12.19.0",
    "google-auth-library": "^10.9.1",
    "jose": "^6.2.12",
    "lit": "^3.3.3",
    "partial-json": "^0.1.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "private": true
}
